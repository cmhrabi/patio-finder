# Canonical public origin, used for metadataBase (Open Graph / link previews).
# Optional on Vercel — falls back to VERCEL_PROJECT_PRODUCTION_URL. Set this
# once you have a custom domain so previews point at it, not *.vercel.app.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Admin auth (/admin) uses Supabase Auth — no extra secret needed.
# Create admin user(s) in the Supabase dashboard: Authentication → Users → Add user,
# and disable public sign-ups so only invited admins can log in.

# Shared secret for /api/cron/sun-batch. Vercel Cron sends this as
# `Authorization: Bearer ${CRON_SECRET}`. Locally, use any opaque string.
CRON_SECRET=local-dev-secret
